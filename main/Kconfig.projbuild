menu "Levoit purifier"

    choice LEVOIT_MODEL
        prompt "Model"
        default LEVOIT_MODEL_CORE300S

        config LEVOIT_MODEL_CORE200S
            bool "Core 200S"
        config LEVOIT_MODEL_CORE300S
            bool "Core 300S"
        config LEVOIT_MODEL_CORE400S
            bool "Core 400S"
        config LEVOIT_MODEL_CORE600S
            bool "Core 600S"
        config LEVOIT_MODEL_SPROUT
            bool "Sprout"
        config LEVOIT_MODEL_EVERESTAIR
            bool "EverestAir"
    endchoice

    config LEVOIT_UART_TX_GPIO
        int "GPIO wired to the purifier controller's RX"
        default 16 if LEVOIT_MODEL_CORE200S
        default 22 if LEVOIT_MODEL_SPROUT
        default 17
        help
            The Core 200S uses 16. The Core 200S-P (hardware version 2.0) uses 17.

    config LEVOIT_UART_RX_GPIO
        int "GPIO wired to the purifier controller's TX"
        default 17 if LEVOIT_MODEL_CORE200S
        default 23 if LEVOIT_MODEL_SPROUT
        default 16
        help
            The Core 200S uses 17. The Core 200S-P (hardware version 2.0) uses 16.

    config LEVOIT_DISPLAY_SWITCH
        bool "Expose the display as a switch"
        default y
        help
            Apple Home shows it as an unnamed outlet tile. Turn off to leave it out.

    config LEVOIT_CHILD_LOCK_SWITCH
        bool "Expose child lock as a switch"
        default y
        help
            Apple Home shows it as an unnamed outlet tile. Turn off to leave it out.

    config LEVOIT_HTTP_OTA
        bool "Accept firmware over HTTP with the update token"
        default n
        help
            Adds POST /ota for tools/ota.sh: about four times faster than a
            Matter update, and it can downgrade. For development. Anyone who
            reads the token off the network can replace the firmware, so
            leave it off on purifiers you are not developing on.

    config LEVOIT_LOG_FRAMES
        bool "Log every serial frame to and from the purifier"
        default n
        help
            One hex line per frame, both directions. For working out a model or
            controller the firmware does not understand yet. Read it with
            tools/watch.sh. Fills the log quickly, so leave it off otherwise.

endmenu
